.seccion-cabeza
  %span.ceja Historial académico
  %h2.seccion-titulo#t-historial
    = historial.size == 1 ? 'Un período cursado' : "#{historial.size} períodos cursados"
  %span.seccion-meta
    = grade.school.short_name
    - if grade.start_process
      = "· desde #{grade.start_process.period_name}"

- if historial.empty?
  .tarjeta.vacio Aún no tienes períodos cursados. Tu historial aparecerá aquí al cierre de tu primer período.
- else
  .historial-grid

    - if serie_pps.size > 1
      .tarjeta.grafico-tarjeta
        %p.grafico-titulo Promedio ponderado por período (PPS)
        %p.grafico-sub Escala 0–20
        .grafico-wrap{data: {controller: :sparkline, sparkline_points_value: serie_pps.to_json}}
          %svg{data: {sparkline_target: :svg}, width: '100%', height: 150, viewBox: '0 0 460 150', role: :img,
               'aria-label': "Evolución del promedio ponderado por período: #{serie_pps.map { |p, v| "#{numero_portal(v)} en #{p}" }.join('; ')}."}
          .tooltip-spark{data: {sparkline_target: :tooltip}, role: :presentation}

    .tarjeta.periodos
      - intentos = intentos_por_registro(historial)
      - historial.each_with_index do |eap, indice|
        - registros = eap.academic_records.sort_by { |ar| ar.subject.code }
        - cache [grade, eap, registros.map(&:updated_at).max] do
          - creditos = registros.reject(&:retirado?).sum { |ar| ar.subject.unit_credits }
          - retiradas = registros.count(&:retirado?)
          - aplazadas = registros.count(&:aplazado?)
          %details.periodo{open: indice.zero?}
            %summary
              %span.periodo-codigo= eap.academic_process.period_name
              %span.periodo-resumen
                - resumen = ["#{registros.size} asignaturas", "#{creditos} créditos"]
                - resumen << "#{retiradas} retirada#{'s' if retiradas > 1}" if retiradas.positive?
                - resumen << "#{aplazadas} aplazada#{'s' if aplazadas > 1}" if aplazadas.positive?
                = resumen.join(' · ')
              %span.periodo-pps
                - if eap.weighted_average.to_f.positive?
                  = numero_portal(eap.weighted_average)
                  %small PPS
                - else
                  —
              = chip_inscripcion(eap)
              %svg.flecha{viewBox: '0 0 16 16', fill: :none, 'aria-hidden': true}
                %path{d: 'M4 6l4 4 4-4', stroke: 'currentColor', 'stroke-width': 1.6, 'stroke-linecap': :round, 'stroke-linejoin': :round}
            .periodo-cuerpo
              .tabla-scroll
                %table.notas
                  %thead
                    %tr
                      %th{scope: :col} Código
                      %th{scope: :col} Asignatura
                      %th.num{scope: :col} Créd.
                      %th.num{scope: :col} Sección
                      %th.num{scope: :col} Calif.
                      %th{scope: :col} Estado
                  %tbody
                    - registros.each do |ar|
                      %tr
                        %td.cod= ar.subject.code
                        %td.asig-n= nombre_asignatura(ar.subject.name)
                        %td.num= ar.subject.unit_credits
                        %td.num.cod= ar.section.code
                        %td.num.cal= ar.retirado? ? '—' : ar.q_value_to_02i
                        %td
                          = chip_portal(estado_record(ar), tono_academic_record(ar))
                          - if (intento = intentos[ar.id]) && intento > 1
                            %small.text-muted= "#{intento}.ª inscripción"
              .periodo-pie
                %span
                  Eficiencia del período:
                  %b= numero_portal(eap.efficiency)
                %span
                  Promedio simple:
                  %b= numero_portal(eap.simple_average)
                - if eap.confirmado? && [grade.school.active_process, grade.school.enroll_process].compact.include?(eap.academic_process)
                  %span.docs
                    - unless eap.any_permanence_articulo?
                      = enlace_descarga 'Constancia de estudio', "/enroll_academic_processes/#{eap.id}.pdf?study='true'"
                    = enlace_descarga 'Constancia de inscripción', "/enroll_academic_processes/#{eap.id}.pdf"

      - if grade.total_credits_eq.positive?
        %p.nota-eq
          %svg{width: 14, height: 14, viewBox: '0 0 16 16', fill: :none, 'aria-hidden': true}
            %circle{cx: 8, cy: 8, r: 6.4, stroke: 'currentColor', 'stroke-width': 1.3}
            %path{d: 'M8 7.4v3.4M8 5.2v.2', stroke: 'currentColor', 'stroke-width': 1.4, 'stroke-linecap': :round}
          %span
            %b Equivalencias:
            = "#{grade.total_credits_eq} créditos reconocidos por equivalencia, incluidos en el total de créditos aprobados."
