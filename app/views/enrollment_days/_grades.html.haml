.overflow-scroll
  %table.table.table-striped.table-sm.table-hover.table-bordered.table-responsive.tableDataMia
    %thead
      %tr
        %th #
        %th.text-center.align-middle= "Estado Insc #{academic_process.period.name}"
        %th.text-center.align-middle Est. Permanencia
        %th Sede
        %th Cédula
        %th.col-name Apellidos, Nombres
        %th.text-center Eficiencia
        %th.text-center Promedio
        %th.text-center Ponderado
    %tbody
      -# anterior_cita = nil
      - grades.each_with_index do |grade, i|
        %tr
          %td= i+1
          %td.text-center.align-middle= grade.label_status_enroll_academic_process(academic_process.id)
          %td.text-center.align-middle= grade.label_current_permanence_status
          %td= grade.student.sede
          %td= grade.student.user_ci
          -# rails_admin corta las celdas a 150 px: con col-name (custom_style) el nombre va completo y, si no cabe, baja de línea.
          %td.col-name= link_to grade.user.reverse_name, "/admin/student/#{grade.student_id}", target: '_black'
          %td.text-center= grade.efficiency
          %td.text-center= grade.simple_average
          %td.text-center= grade.weighted_average
        -# anterior_cita = @cita_horaria
