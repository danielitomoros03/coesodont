%br
%br
.overflow-scroll
  %table.table.table-striped.table-sm.table-hover.table-bordered.table-responsive.tableDataMia
    %thead
      %tr
        %th.text-center= "Estado Insc #{academic_process.period.name}"
        %th.text-center Sede
        %th Cédula
        %th.col-name Apellidos, Nombres
        %th.text-center Desde
        %th.text-center Hasta
        %th.text-center.align-middle Est. Permanencia
        -# El período va en una segunda línea: en una sola, cada encabezado de número le quitaba ancho al nombre.
        - %w[Eficiencia Promedio Ponderado].each do |numero|
          %th.text-center
            = numero
            %br
            %small.fw-normal= academic_process.process_before.period.name
    %tbody
      - grades.each do |grade, i|
        - student = grade.student
        - reverse_name = student.user.reverse_name
        - eap = grade.enroll_academic_processes.joins(:period).order(['periods.year': :desc, 'periods.period_type_id': :desc]).first
        %tr
          %td.text-center= grade.label_status_enroll_academic_process(academic_process.id)
          %td= student.sede 
          %td= student.user_ci
          -# rails_admin corta las celdas a 150 px: con col-name (custom_style) el nombre va completo y, si no cabe, baja de línea.
          %td.col-name= link_to reverse_name, "/admin/student/#{grade.student_id}", target: '_black'
          %td.text-center= grade.appointment_from 
          %td.text-center= grade.appointment_to
          %td.text-center.align-middle= grade.label_current_permanence_status
          %td.text-center= eap.efficiency
          %td.text-center= eap.simple_average
          %td.text-center= eap.weighted_average
