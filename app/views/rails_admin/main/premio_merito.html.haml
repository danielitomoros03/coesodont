-# Premio al Mérito Académico de ODON, por la carrera (Daniel, 9-nov-2026; FHE y FAU siguen por el año). Las
-# pestañas cambian de lista sin ir al servidor y recuerdan la elegida (`vista`) al cambiar de período.
- premio = School::PremioMeritoCarrera.new(@object, params[:anio])
- anio = premio.anio

= turbo_frame_tag 'premio_merito', data: { turbo_action: 'advance', controller: 'pestanas' } do
  %h5.text-primary.fw-bold.mb-3
    %i.fa-solid.fa-award.me-2
    = "Premio al Mérito Académico · #{@object.name}"

  - if anio.nil?
    .alert.alert-light.text-center.text-muted Esta escuela todavía no tiene años cursados.
  - else
    .d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.mb-3
      %ul.nav.nav-pills
        - premio.anios.each do |a|
          %li.nav-item
            = link_to rails_admin.premio_merito_path(model_name: 'school', id: @object.id, anio: a.numero, vista: params[:vista]), class: "nav-link #{'active' if a.numero == anio.numero}", data: { pestanas_target: 'enlace' } do
              = a.numero
              - if a.en_curso?
                %span.badge.rounded-pill.bg-warning.text-dark.ms-1 en curso
      = link_to rails_admin.premio_merito_path(model_name: 'school', id: @object.id, anio: anio.numero, formato: 'xlsx'), class: 'btn btn-outline-success btn-sm', data: { turbo: false } do
        %i.fa-solid.fa-file-excel.me-1
        = "Descargar Excel #{anio.numero}"

    = render 'rails_admin/main/premio_merito_carrera', premio: premio
